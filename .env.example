# Copy to .env and fill in. Never commit the real .env.

# Master switch: applications are only submitted when this is "true".
AUTO_APPLY=false

# Path overrides (optional)
# JOBBOT_DB=state/jobbot.db
# JOBBOT_APPLICANT=config/applicant.yaml

# Google Sheets (service account JSON, either a path or the raw JSON)
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
SHEETS_SPREADSHEET_ID=

# Email notifications (any SMTP provider; for Gmail use an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# Write filtered-out jobs to the sheet too (debugging)
# SHEETS_DEBUG=false
